# Copy to .env in this folder and fill in. Never commit the real .env.
DOMAIN=callie.example.com
GROQ_API_KEY=
# People sign in with one of these codes (comma separated). Give each person or group their own.
INVITE_CODES=choose-a-code,another-code
# Fair use: minutes of calling per person per day, and calls at the same time
LIMIT_MINUTES_PER_DAY=30
MAX_CONCURRENT_CALLS=4
# Optional extras
# SUNBIRD_API_TOKEN=
# CEREBRAS_API_KEY=
# SESSION_SECRET=
CALLS_PER_DEVICE_PER_DAY=5
